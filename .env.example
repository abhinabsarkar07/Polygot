# Copy this file to backend/.env and fill in real values locally.
# Never commit the real .env file.

APP_ENV=development
DATABASE_URL=postgresql://polyglot_app:CHANGE_ME@localhost:5432/polyglot
FRONTEND_ORIGIN=http://localhost:5173

# Optional. Each provider's adapter is only registered if its key is set --
# a missing key means that provider is simply unavailable, not a startup
# crash. Leave empty to develop against whichever providers you don't have
# a key for; see docs/PROVIDER_NOTES.md for what was live- vs fixture-tested.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
